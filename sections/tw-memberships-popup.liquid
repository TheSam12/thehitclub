<style>
  {% for block in section.blocks %}#membershipsPopup{{ forloop.index }}{% unless forloop.last %},{% endunless %}{% endfor %}{
    display: none;
  }

  {% for block in section.blocks %}#membershipsPopup{{ forloop.index }}.openPopup{% unless forloop.last %},{% endunless %}{% endfor %} {
    display: block;
    position: fixed;
    top: 0;
    bottom: 0;
    right: 0;
    left: 0;
  }

  .popup-overlay {
    background: rgba(0, 0, 0, 0.4);
    z-index: 30;
    color: transparent;
    position: sticky;
    width: 100vw;
    height: 100vh;
    top: 0;
  }

  .memberships-hati-hover:hover {
    background: linear-gradient(90deg, rgb(255, 255, 255), rgb(254, 211, 108));
  }

  .memberships-gati-hover:hover {
    background: linear-gradient(90deg, rgb(255, 255, 255), rgb(253, 112, 186));
  }

  .openPopup .popup-position{
    opacity: 1;
  }

  .popup-position {
    top: 10%;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .tw-z-1 {
    z-index: 1;
  }

  @media (min-width: 1024px) {
    .popup-position {
      left: calc(50% - 490px);
      top: calc(50% - 171.5px);
    }
  }
</style>
{% for block in section.blocks %}
  {% liquid
    assign var = block.settings
    assign bg1 = var.bg1
    assign bg2 = var.bg2
    assign hatiImg = var.hatiImg
    assign hatiDesc = var.hatiDesc
    assign hatiUrl = var.hatiUrl
    assign hatiLabel = var.hatiLabel
    assign gatiImg = var.gatiImg
    assign gatiDesc = var.gatiDesc
    assign gatiUrl = var.gatiUrl
    assign gatiLabel = var.gatiLabel
  %}
  <style>
    .membershipsPopup {
      background: linear-gradient(to right, {{bg1}} 0%, {{bg2}} 100%);
    }
  </style>
  <div id="membershipsPopup{{ forloop.index }}">
    <div>
      <div class="popup-position tw-absolute tw-z-40 tw-p-5 lg:tw-w-[980px] lg:tw-p-0">
        <div class="membershipsPopup tw-relative tw-rounded-3xl tw-p-6">
          <div class="tw-absolute tw-right-6 tw-top-4 tw-cursor-pointer tw-text-xl" onclick="closeMemberPopup()">X</div>
          <div class="tw-flex tw-flex-col tw-gap-12 lg:tw-grid lg:tw-grid-cols-2">
            <div class="tw-flex tw-flex-col tw-items-center tw-justify-center tw-gap-4">
              {% if hatiImg != blank %}
                {{ hatiImg | image_url: width: 100 | image_tag }}
              {% endif %}
              {% if hatiDesc != blank %}
                <div class="tw-text-center tw-text-xs tw-text-black lg:tw-text-base">{{ hatiDesc }}</div>
              {% endif %}
              {% if hatiLabel != blank %}
                <a
                  href="{{ hatiUrl }}"
                  class="memberships-hati-hover tw-w-full tw-rounded-3xl tw-bg-white tw-p-2 tw-text-center tw-text-sm tw-font-bold tw-uppercase tw-text-black lg:tw-text-lg"
                >
                  {{- hatiLabel -}}
                </a>
              {% endif %}
            </div>
            <div class="tw-flex tw-flex-col tw-items-center tw-justify-center tw-gap-4">
              {% if gatiImg != blank %}
                {{ gatiImg | image_url: width: 100 | image_tag }}
              {% endif %}
              {% if gatiDesc != blank %}
                <div class="tw-text-center tw-text-xs  tw-text-black lg:tw-text-base">{{ gatiDesc }}</div>
              {% endif %}
              {% if gatiLabel != blank %}
                <a
                  class="memberships-gati-hover tw-w-full tw-cursor-pointer tw-rounded-3xl tw-bg-white tw-p-2 tw-text-center tw-text-sm tw-font-bold tw-uppercase tw-text-black lg:tw-text-lg"
                  href="{{ gatiUrl }}"
                >
                  {{- gatiLabel -}}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
      <div class="popup-overlay" onclick="closeMemberPopup()">p</div>
    </div>
  </div>
{% endfor %}

<script>
  const headerIndex = document.getElementById('shopify-section-tw-header');
  const body = document.getElementById('themeBody');
  {% for block in section.blocks %}
    const memberPopup{{ forloop.index }} = document.getElementById('membershipsPopup{{ forloop.index }}');
    function openMemberPopup{{ forloop.index }}() {
      memberPopup{{ forloop.index }}.classList.add('openPopup');
      headerIndex.classList.remove('tw-sticky');
      body.classList.add('tw-overflow-hidden');
    }
  {% endfor %}
  function closeMemberPopup() {
    {% for block in section.blocks %}
      memberPopup{{ forloop.index }}.classList.remove('openPopup');
    {% endfor %}
    headerIndex.classList.add('tw-sticky');
    body.classList.remove('tw-overflow-hidden');
  }
</script>

{% schema %}
{
  "name": "Popup memberships",
  "class": "tw-mb-8 tw-z-20 tw-relative",
  "blocks": [
    {
      "type": "popup",
      "name": "Popup",
      "settings": [
        {
          "type": "header",
          "content": "Popup settings"
        },
        {
          "type": "color",
          "default": "#FD70BA",
          "id": "bg1",
          "label": "First background color"
        },
        {
          "type": "color",
          "default": "#F0DC61",
          "id": "bg2",
          "label": "Second background color"
        },
        {
          "type": "image_picker",
          "id": "hatiImg",
          "label": "Hati logo image"
        },
        {
          "type": "richtext",
          "id": "hatiDesc",
          "label": "Hati description",
          "default": "<p>Hacer ejercicio y estar saludable puede ser difícil. Home & Tone it® elimina esos obstáculos. Nuestras rutinas, diseñadas para hacer en casa en menos de 60 minutos con equipo básico, te facilitan estar en forma.</p>"
        },
        {
          "type": "url",
          "id": "hatiUrl",
          "label": "Hati url redirection"
        },
        {
          "type": "text",
          "id": "hatiLabel",
          "label": "Hati redirect button label",
          "default": "TRAIN AT HOME"
        },
        {
          "type": "image_picker",
          "id": "gatiImg",
          "label": "Gati logo image"
        },
        {
          "type": "richtext",
          "id": "gatiDesc",
          "label": "Gati description",
          "default": "<p>Muchas personas cometen errores al entrenar sin guía en el gimnasio. Gym & Tone It® te enseña a usar correctamente cada máquina y te ofrece nuevas rutinas diarias para trabajar cada músculo del cuerpo.</p>"
        },
        {
          "type": "url",
          "id": "gatiUrl",
          "label": "Gati url redirection"
        },
        {
          "type": "text",
          "id": "gatiLabel",
          "label": "Gati redirect button label",
          "default": "TRAIN AT THE GYM"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Memberships With Popup",
      "blocks": [
        {
          "type": "popup"
        },
        {
          "type": "popup"
        },
        {
          "type": "popup"
        }
      ]
    }
  ]
}
{% endschema %}
